{
  "manifest_version": 3,
  "name": "YASTL Connect",
  "version": "0.1.0",
  "description": "Capture 3D model downloads from Printables, Thingiverse, MakerWorld and others straight into your YASTL library, with the page's metadata attached.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "*://*.printables.com/*",
    "*://*.thingiverse.com/*",
    "*://*.makerworld.com/*",
    "*://*.bblmw.com/*",
    "*://*.thangs.com/*",
    "*://*.myminifactory.com/*",
    "*://*.cults3d.com/*",
    "*://*.amazonaws.com/*",
    "*://*.cloudfront.net/*",
    "*://storage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "YASTL Connect",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.printables.com/*",
        "*://*.thingiverse.com/*",
        "*://*.makerworld.com/*",
        "*://*.thangs.com/*",
        "*://*.myminifactory.com/*",
        "*://*.cults3d.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
